              "description": "Provider-native source ID.",
              "example": "tc-2026-05-20-example-round"
            }
          },
          {
            "description": "Provider-native source slug.",
            "example": "example-round",
            "in": "query",
            "name": "sourceProviderSlug",
            "required": false,
            "schema": {
