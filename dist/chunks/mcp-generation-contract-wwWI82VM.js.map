    "/v1/web/page": {
      "get": {
        "description": "Fetches the markdown content of any public URL through crawl4ai. Returns fit-filtered markdown by default; when the filtered body is empty it falls back to the raw (unfiltered) body, then to the Bright Data Web Unlocker where configured — the response's filter field names the served variant. A 200 with empty markdown means every fetcher found no content on the page. Exact provider response bytes are retained before decoding, and a fresh stored capture serves without a provider call unless forceRefresh=true.",
        "operationId": "fetchPage",
        "parameters": [
          {
            "description": "Public http(s) URL to fetch",
