            "$ref": "#/components/schemas/EntityPersonOwner",
            "description": "Owner the caller attempted to attach the URL to."
          },
          "url": {
            "type": "string",
            "description": "Raw URL as submitted by the caller (pre-normalization)."
          },
          "urlType": {
            "type": "string",
            "description": "URL type submitted by the caller (e.g., 'website', 'twitter'). The conflict applies only within this urlType."
          }
        },
