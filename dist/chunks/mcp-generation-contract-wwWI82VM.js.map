            "example": "aventure.vc",
            "in": "query",
            "name": "sourceDetail",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Source detail or reviewer reference for the write.",
              "example": "aventure.vc"
            }
          },
          {
            "description": "Provider name for provider-native IDs or slugs.",
            "example": "TechCrunch",
            "in": "query",
            "name": "sourceProvider",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Provider name for provider-native IDs or slugs.",
              "example": "TechCrunch"
