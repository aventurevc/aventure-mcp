    "/v1/entities/merge": {
      "post": {
        "description": "Merge two duplicate entities after duplicate review. The survivor keeps its id, the loser is removed, relationships move to the survivor, optional survivor fields may be patched, and a slug redirect is created by default. Known duplicate fundraise and same-month latest-valuation collisions are resolved before foreign-key repointing. Requires write and delete authority.",
        "operationId": "mergeEntities",
        "parameters": [
          {
            "description": "Write provenance source type.",
            "in": "query",
            "name": "sourceType",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/DatasourceWritableDataSourceType",
              "example": "aventureStaff"
            }
          },
          {
            "description": "Source detail or reviewer reference for the write.",
            "example": "aventure.vc",
            "in": "query",
            "name": "sourceDetail",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Source detail or reviewer reference for the write.",
              "example": "aventure.vc"
            }
          },
          {
            "description": "Provider name for provider-native IDs or slugs.",
            "example": "TechCrunch",
            "in": "query",
            "name": "sourceProvider",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Provider name for provider-native IDs or slugs.",
              "example": "TechCrunch"
            }
          },
          {
            "description": "Provider-native source ID.",
            "example": "tc-2026-05-20-example-round",
            "in": "query",
            "name": "sourceProviderId",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Provider-native source ID.",
              "example": "tc-2026-05-20-example-round"
