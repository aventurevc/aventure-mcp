      "patch": {
        "description": "Sets one entity's typeRecord from a concrete EntityType value or accepted alias. For single-slug entity routes, when the typeRecord changes the public route prefix, the server automatically redirects the actual prior public path for the unchanged slug to the new canonical public path, retargets existing upstream redirect chains, and removes any redirect whose source is now canonical. When setting Product or Service and no current provider relationship exists, set productServiceProviderId so the productService relationship is created in the same transaction. Product/Service nameBrand must not exactly match the provider; eponymous offerings without a distinct brand should use a descriptor/category such as Consumer Sedans or Light Industrial Vehicles. Organization is group-only and is rejected as an individual typeRecord. Use GET /v1/entities/types to inspect writable values, meanings, and aliases.",
        "operationId": "setTypeRecord",
        "parameters": [
          {
            "description": "Canonical entity UUID",
            "in": "path",
            "name": "entityId",
            "required": true,
            "schema": {
              "type": "string",
