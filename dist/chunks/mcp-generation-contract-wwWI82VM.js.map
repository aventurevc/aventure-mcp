    "/health/readiness": {
      "get": {
        "description": "Returns the readiness health group. Used by load balancers and Kubernetes readiness probes to gate traffic. Carries the running build's git revision so deploy runtime acceptance can prove the new revision serves traffic.",
        "operationId": "readiness",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/CompositeHealthDescriptor"
                    },
                    {
                      "$ref": "#/components/schemas/IndicatedHealthDescriptor"
                    },
                    {
                      "$ref": "#/components/schemas/SystemHealthDescriptor"
                    }
                  ]
                }
              }
            },
            "description": "Readiness health with the running build's revision identity",
            "headers": {
              "X-Aventure-Revision": {
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "400": {
