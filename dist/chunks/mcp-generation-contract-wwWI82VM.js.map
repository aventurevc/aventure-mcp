    "/v1/entities/relationships/join": {
      "post": {
        "description": "Creates one directed relationship between two existing entities and returns the row. The created row is always isCurrent=true and isPrimary=true, so it appears in default relationship reads. relationshipType must be joinable=true from entities relationships types; its direction/sourceRole/targetRole fields describe whether source/target order is symmetric, auto-oriented, or directional. For parent, sourceEntityId is the parent and targetEntityId is the child. For affinity, sourceEntityId is the member organization and targetEntityId is the provider organization; the companies list affinity filter accepts provider names only. For productService, one side must be Product or Service and the provider side must be Company, Nonprofit, Government, or Business Line; Investment Firm, Fund, and group-only Organization are rejected because they cannot own products/services. AcquisitionManaged and readOnly types are rejected. For acceleratorParticipant, one side must be the participant entity and the other side must be the accelerator entity with typeRecord=Investment Firm; the join endpoint stores participant as source and accelerator as target. acceleratorParticipant requires detail as `batch=<label>` or `program=<name>; batch=<label>` plus asOf. Use entities relationships row create when writing historic/non-primary curation flags. Missing or malformed query parameters return 400. A relationshipType whose source/target entity-type pairing is not accepted, an acquisitionManaged or readOnly relationshipType, missing acceleratorParticipant detail/asOf, or sourceEntityId equal to targetEntityId returns 422. A productService join that would create an ambiguous Product/Service slug route, a duplicate relationship, or parent/acquisition exclusivity for the same unordered entity pair returns 409; duplicate directional conflicts name the existing row and the required sourceRole/targetRole orientation. An unresolved sourceEntityId or targetEntityId returns 404.",
        "operationId": "joinRelationship",
        "parameters": [
          {
            "description": "Relationship source entity UUID, not provenance source metadata. For parent this is the parent entity. For affinity this is the member organization. For acceleratorParticipant this may be either side; join auto-orients so the stored source is the participant entity.",
            "in": "query",
            "name": "sourceEntityId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "description": "Relationship target entity UUID. For parent this is the child entity. For affinity this is the provider organization. For acceleratorParticipant this may be either side, but exactly one side must be the accelerator entity with typeRecord=Investment Firm.",
            "in": "query",
            "name": "targetEntityId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "description": "Joinable EntityRelationshipType, one of: acceleratorParticipant, affinity, competingProductService, competitor, customer, fundManagerFirm, parent, productService, serviceProvider, similarCompany, spinOffFrom, successor. Use entities relationships types; valid join values have joinable=true and expose direction/sourceRole/targetRole labels.",
            "in": "query",
            "name": "relationshipType",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Effective date for this relationship when known",
            "in": "query",
            "name": "asOf",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "description": "Source URL or compact source label copied to the relationship row",
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Relationship-specific detail. Required for acceleratorParticipant as `batch=<label>` or `program=<name>; batch=<label>`. Pair it with asOf.",
            "in": "query",
            "name": "detail",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Write provenance source type.",
            "in": "query",
            "name": "sourceType",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/DatasourceWritableDataSourceType",
              "example": "aventureStaff"
            }
          },
          {
            "description": "Source detail or reviewer reference for the write.",
            "example": "aventure.vc",
            "in": "query",
            "name": "sourceDetail",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Source detail or reviewer reference for the write.",
              "example": "aventure.vc"
            }
          },
          {
            "description": "Provider name for provider-native IDs or slugs.",
            "example": "TechCrunch",
            "in": "query",
            "name": "sourceProvider",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Provider name for provider-native IDs or slugs.",
              "example": "TechCrunch"
            }
          },
          {
            "description": "Provider-native source ID.",
            "example": "tc-2026-05-20-example-round",
            "in": "query",
            "name": "sourceProviderId",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Provider-native source ID.",
              "example": "tc-2026-05-20-example-round"
            }
          },
          {
            "description": "Provider-native source slug.",
            "example": "example-round",
            "in": "query",
            "name": "sourceProviderSlug",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Provider-native source slug.",
              "example": "example-round"
            }
          },
          {
            "description": "Actor type; inferred as agent when agentChassis and agentModel are supplied, or as employee from an authenticated user JWT session.",
            "example": "agent",
            "in": "query",
            "name": "actorType",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/DatasourceProvenanceActorType"
            }
          },
          {
            "description": "Agent chassis token for agent-authored writes.",
            "example": "codex-cli",
            "in": "query",
            "name": "agentChassis",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Agent chassis token for agent-authored writes.",
              "example": "codex-cli"
            }
          },
          {
            "description": "Agent model id for agent-authored writes.",
            "in": "query",
            "name": "agentModel",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Agent model id for agent-authored writes."
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityRelationship"
                }
              }
            },
            "description": "Created relationship row. Directional warnings also appear in Warning, X-Contract-Warning-Code, and X-Contract-Warning-Key headers."
          },
          "400": {
            "description": "Missing or malformed required query parameter."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "description": "sourceEntityId or targetEntityId does not resolve to an entity."
          },
          "406": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Not Acceptable"
          },
          "409": {
            "description": "Product/Service slug conflict when a productService join would create ambiguous detail routing, duplicate relationship row, or parent/acquisition exclusivity conflict for the same unordered entity pair. Directional duplicate responses include the existing row id and sourceRole/targetRole recovery guidance."
          },
          "422": {
            "description": "Invalid pair, invalid productService provider type, read-only/acquisition-managed type, missing acceleratorParticipant batch/asOf detail, or identical sourceEntityId and targetEntityId."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "adminApiKeyAuth": []
          }
        ],
        "summary": "Join two entities",
        "tags": [
          "Entity Relationships"
        ],
        "x-aventure-tool": {
          "cli": "entities relationships join"
        }
      }
    },
