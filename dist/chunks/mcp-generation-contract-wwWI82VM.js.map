              "description": "Canonical entity UUID",
              "x-source-file": "src/main/kotlin/vc/aventure/domain/model/identity/EntityId.kt"
            }
          },
          {
            "description": "Existing provider entity UUID required when setting typeRecord to Product or Service and the row has no current productService provider join. Use this to repair or move the provider atomically instead of clearing the join.",
            "in": "query",
            "name": "productServiceProviderId",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Canonical entity UUID",
