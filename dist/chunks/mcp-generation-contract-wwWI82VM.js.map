      "delete": {
        "description": "Hard-deletes an investor join from a fundraise round and returns the deleted join as confirmation. Use --entity-id or --entity-slug for the fundraising/portfolio company that raised the round — always a company, never the fund or investment firm that supplied the capital. For an Investment Firm's outgoing investment, pass the portfolio company that received the money here and identify the firm with --investor-entity-id or --investor-entity-slug. Use transactionId for the round id, or round plus dateAnnounced when transactionId is unknown.",
        "operationId": "deleteFundraiseInvestorJoin",
        "parameters": [
          {
            "description": "Owner-scoped resource UUID selector.",
